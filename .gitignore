# Rust
/target/

# Déploiement — config serveur RÉELLE jamais versionnée
# (seuls les gabarits *.example / deploy.example.sh sont commités)
deploy.local.sh
*.local.sh
*.local.env
*.local.cfg
.deploy/
.env
.env.*
!.env.example
!.env.deploy.example

# Secrets / credentials (jamais dans le repo, a fortiori public)
secrets/
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
nginx.local.conf

# Vault de démo local / données runtime
/vaults/
*.local.toml
config.local.toml

# Runtime data (SQLite DB + vaults) — never committed (T-01-04)
/data/

# Atomic-write temp files (vault/atomic.rs pattern: .<name>.tmp-<uuid>)
*.tmp-*

# Divers
.DS_Store
*.log

# Runtime config — may hold api_key; NEVER tracked (T-02). Template: config.example.toml
config.toml
